   },
   "classify_host": "8.8.8.8",
   "expected_kind": "ipv4",
   "expected_private": false,
   "desc": "公网 IP 不具明文资格"
  },
  {
   "id": "ADR-08",
   "parse_input": "127.0.0.1",
   "expected": {
    "ok": true,
    "host": "127.0.0.1",
